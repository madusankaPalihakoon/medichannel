# Local PostgreSQL. Use the SAME username/password in Docker and Spring Boot.
POSTGRES_DB=medichannel
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_TO_YOUR_LOCAL_POSTGRES_PASSWORD
POSTGRES_PORT=5432

# Spring Boot datasource (set these in IntelliJ Run Configuration as environment variables).
SERVER_PORT=8080
DB_URL=jdbc:postgresql://localhost:5432/medichannel_db
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME_TO_YOUR_LOCAL_POSTGRES_PASSWORD
FRONTEND_URL=http://localhost:3000

# Generate fresh secrets. Never commit real values.
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_BYTES
JWT_EXPIRATION_MINUTES=30
APP_ENCRYPTION_KEY_BASE64=REPLACE_WITH_BASE64_OF_32_RANDOM_BYTES
APP_HMAC_KEY_BASE64=REPLACE_WITH_BASE64_OF_32_RANDOM_BYTES
INITIAL_ADMIN_NAME=System Administrator
INITIAL_ADMIN_EMAIL=admin@example.test
INITIAL_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
AUTH_SECURE_COOKIE=false

# Next.js
NEXT_PUBLIC_APP_NAME=MediChannel
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api
